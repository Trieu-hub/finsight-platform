<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>
    <groupId>com.pm</groupId>
    <artifactId>dashboard-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>dashboard-service</name>
    <description>FinSight Dashboard Service (read-only aggregation / BFF)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Kept in sync with the versions the Spring Boot BOM manages (grpc-bom / protobuf-bom),
             so the protobuf-maven-plugin downloads matching protoc / protoc-gen-grpc-java binaries. -->
        <grpc.version>1.83.1</grpc.version>
        <protobuf-java.version>4.34.2</protobuf-java.version>
        <!-- Resilience4j core modules (used programmatically, NOT the Spring Boot AOP starter —
             that starter's autoconfiguration is not verified on Boot 4, and the tracing work
             already showed Boot 4 moved autoconfig around; the core libs have no such coupling). -->
        <resilience4j.version>2.4.0</resilience4j.version>
    </properties>

    <!-- Spring Boot 4.1's BOM manages spring-grpc-core, grpc-bom and protobuf-bom directly, so
         the gRPC/protobuf runtime and generated stubs line up without importing a separate BOM. -->

    <dependencies>
        <!-- Web (servlet) + RestClient for outbound aggregation calls. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Security: validates the JWT locally (auth-service's public key), like every service. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Validation -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Distributed tracing (Boot 4): one starter pulls the Micrometer→OTel bridge, the OTel
             SDK, and the OTLP/HTTP exporter. Spans ship to Tempo; trace context propagates across
             the gateway and Kafka. Exports only when a non-zero sampling probability is set
             (off by default) — see application.yml. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!-- Prometheus metrics export (/actuator/prometheus). Boot 4: the export
             autoconfiguration lives in spring-boot-micrometer-metrics (pulled in by
             the actuator starter) and activates when this registry is on the
             classpath; version managed by the imported micrometer-bom. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Resilience4j: circuit breaker + retry on the BFF's upstream fan-out (transaction/
             budget over REST, user over gRPC). Used programmatically via a small UpstreamCalls
             helper — no AOP/annotations, so no Boot-4 autoconfiguration dependency. The
             micrometer module publishes circuit-breaker state/call metrics to /actuator/prometheus,
             so Grafana and the new Alertmanager rules can see a breaker trip. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- OpenAPI / Swagger UI. springdoc 3.0.x is the Spring Boot 4 / Spring
             Framework 7 line (it composes with the app's Boot 4.0.6 BOM). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- gRPC client. The dashboard BFF calls user-service's internal UserProfileService over
             gRPC (the platform's one internal-sync gRPC call); transaction/budget stay REST.
             Spring Boot 4.1 owns the client autoconfiguration (spring-grpc's client starter was
             folded into Boot as spring-boot-starter-grpc-client); grpc-stub/grpc-protobuf back the
             generated stubs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-grpc-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.protobuf</groupId>
            <artifactId>protobuf-java</artifactId>
        </dependency>

        <!-- JWT (same jjwt stack/version as the rest of the platform). -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test. NOTE: no Testcontainers — this service owns no database. Upstream HTTP
             calls are stubbed with MockRestServiceServer (ships in spring-boot-starter-test). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4 ships MockMvc test support (@AutoConfigureMockMvc) in this module. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- In-process gRPC transport: UserClientTest runs the client against a real
             (in-JVM) gRPC server with no sockets. Version managed by the grpc BOM. -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compiles src/main/proto (the client-side copy of user-service's contract)
                 into Java stubs. Auto-detects OS and downloads matching protoc + the gRPC
                 codegen binary, so it runs unchanged on Windows (local) and Linux (CI). -->
            <plugin>
                <groupId>io.github.ascopes</groupId>
                <artifactId>protobuf-maven-plugin</artifactId>
                <version>5.1.7</version>
                <configuration>
                    <protoc>${protobuf-java.version}</protoc>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <plugins>
                                <plugin kind="binary-maven">
                                    <groupId>io.grpc</groupId>
                                    <artifactId>protoc-gen-grpc-java</artifactId>
                                    <version>${grpc.version}</version>
                                </plugin>
                            </plugins>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
