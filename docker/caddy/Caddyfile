# Caddy edge for the Path A deploy: automatic HTTPS (Let's Encrypt) + reverse proxy.
# The domain and ACME email are injected from the environment (see docker-compose.prod.yml).
{
	# ACME account email (optional but recommended for expiry notices). Empty is allowed.
	email {$FINSIGHT_ACME_EMAIL}

	# rate_limit is a third-party directive (caddy-ratelimit plugin) — tell Caddy where it
	# sits in the middleware chain so it runs before the request is proxied.
	order rate_limit before basicauth
}

{$FINSIGHT_DOMAIN} {
	# Cloudflare Origin certificate (15-year), used when the site sits behind Cloudflare's
	# proxy (orange cloud). Cloudflare terminates the browser-facing TLS; this cert only
	# secures the Cloudflare<->origin leg. No ACME needed, so it keeps working even though
	# the proxy blocks Let's Encrypt's TLS-ALPN challenge. NOTE: this cert is trusted ONLY by
	# Cloudflare, not by browsers — so the proxy MUST stay ON and SSL/TLS mode = Full (strict).
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	encode gzip zstd

	# Security headers. Measured absent on 2026-08-21: the site shipped none of these, which left
	# clickjacking, MIME sniffing and full referrer leakage available for free. Set at the edge
	# rather than per-service so one place covers the SPA and the API alike.
	header {
		# Force HTTPS for a year. `preload` is deliberately NOT set: getting onto the browsers'
		# preload list is easy and getting off it takes months, so it is a decision to make on
		# purpose rather than a header to copy.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# Content-Security-Policy. Verified feasible before enforcing: the built app loads NOTHING
		# cross-origin — no CDN, no web fonts, no analytics — and index.html carries no inline
		# <script>. So 'self' is enough everywhere except style, where React's `style={{...}}`
		# attributes (the budget/progress bars) need 'unsafe-inline'.
		#   frame-ancestors 'none'  — the app is never framed; this is the modern X-Frame-Options
		#   connect-src 'self'      — the API is same-origin, so nothing should call out
		#   object-src 'none'       — no plugins, and <object> is a classic injection sink
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

		# Kept alongside CSP's frame-ancestors for browsers that predate it.
		X-Frame-Options "DENY"
		# Stops a browser guessing a content type — the trick that turns an uploaded file into a
		# script. The CSV import means user-supplied bytes do reach this origin.
		X-Content-Type-Options "nosniff"
		# A finance app's URLs name what the user was looking at; send the origin, never the path.
		Referrer-Policy "strict-origin-when-cross-origin"
		# Nothing here needs any of these, and an unused permission is only ever a liability.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

		# The upstream's exact nginx version is free reconnaissance for anyone scanning.
		-Server
	}

	# Access log. Without it there is no way to answer "who hit the site, and when" — the
	# services log their own work but nothing records a request that never reached them (a 404,
	# a static asset, a bot sweep). Promtail discovers this container over the Docker socket, so
	# stdout lands in Loki and is queryable in Grafana with no further wiring.
	#
	# The filter is not optional. Caddy's JSON encoder logs the request headers, and this origin
	# carries bearer tokens on every authenticated call — writing them to disk would turn the log
	# into a credential store that outlives the token's own expiry.
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Set-Cookie delete
			}
		}
	}

	# Edge rate limiting on the token-minting auth endpoints — stops bulk registration / login
	# brute-force (a load test once created ~84k accounts here) and abuse of /refresh, which also
	# issues fresh access tokens. Keyed on the REAL client IP via Cloudflare's CF-Connecting-IP
	# header, because we sit behind Cloudflare's proxy and {remote_host} would otherwise be a
	# shared Cloudflare address (throttling everyone as one). 10 requests / minute / IP; excess
	# gets HTTP 429. Humans never hit this; scripts do.
	@auth path /api/v1/auth/register /api/v1/auth/login /api/v1/auth/refresh
	rate_limit @auth {
		zone auth {
			key    {http.request.header.CF-Connecting-IP}
			events 10
			window 1m
		}
	}

	# API traffic (the SPA calls a relative /api/v1/...) goes to the gateway, which
	# validates the JWT at the edge and forwards to the services on the internal network.
	handle /api/* {
		reverse_proxy api-gateway:8080
	}

	# Everything else is the React single-page app, served by the nginx `web` container
	# (which does the client-side history fallback).
	handle {
		reverse_proxy web:80
	}
}

# `www.` is a redirect, not a second copy of the site. Without this block Caddy matches no site
# for a `Host: www.vernfy.com` request and answers an empty 200, so typing the www form used to
# land on a blank page (DNS and Cloudflare's edge cert were never the problem — the www record
# already resolves and Universal SSL covers *.vernfy.com).
#
# One canonical origin is deliberate: the SPA and the API share an origin, so serving both names
# would split JWTs and localStorage across two of them and let a user be "logged in" on one and
# not the other.
#
# 308 rather than 301 because /api/* lives on this same origin — a 301 lets a client downgrade a
# POST to GET, which would silently turn a login into a no-op. 308 preserves method and body.
#
# Same Cloudflare Origin cert as above: it must list `*.vernfy.com` (or www explicitly) in its
# SAN, otherwise Cloudflare's Full (strict) mode rejects this leg with error 526 — see deploy.md.
www.{$FINSIGHT_DOMAIN} {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key

	redir https://{$FINSIGHT_DOMAIN}{uri} 308
}
